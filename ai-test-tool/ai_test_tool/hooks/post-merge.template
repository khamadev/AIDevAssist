#!/usr/bin/env bash
# Installed by ai-test-tool's `init` command. Do not edit directly —
# edit ai_test_tool/hooks/post-merge.template instead and re-run init.
#
# Fires after `git pull`/`git merge` brings in new commits locally — this
# is what catches PR merges done on GitHub's web UI, which happen
# server-side and never trigger post-commit on anyone's machine. Reuses
# the post-commit stage: documentation logs whatever commit is now HEAD.
#
# The path below is substituted at install time with the absolute path to
# the interpreter `init` was run with — see pre-commit.template for why.
cd "$(git rev-parse --show-toplevel)"
"{{PYTHON_EXE}}" -m ai_test_tool.cli orchestrate --stage post-commit --target .
